#!/bin/sh
# B162/H28: fail closed on destructive primary-main reference transactions.

state=${1-}
if [ "$state" != "prepared" ]; then
    exit 0
fi

bypass_main_guard=false
if [ "${ORCH_MAIN_GUARD_BYPASS-}" = "1" ]; then
    bypass_main_guard=true
fi

authorized_orch_merge=false
if [ "${ORCH_MAIN_GUARD_CONTEXT-}" = "authorized-no-ff-merge" ]; then
    authorized_orch_merge=true
fi

# Compare physical git-dir identities instead of matching a `/worktrees/`
# substring: a perfectly ordinary repository may itself live below a path
# with that name. Resolution errors are retained and handled fail-closed only
# if this transaction actually updates a protected ref; topic refs stay free.
primary_state=unknown
primary_error=""
git_dir=$(git rev-parse --git-dir 2>/dev/null) || primary_error="cannot resolve GIT_DIR"
common_dir=$(git rev-parse --git-common-dir 2>/dev/null) || primary_error="cannot resolve git common dir"
if [ -z "$primary_error" ]; then
    git_dir_abs=$(cd "$git_dir" 2>/dev/null && pwd -P) || primary_error="cannot canonicalize GIT_DIR"
    common_dir_abs=$(cd "$common_dir" 2>/dev/null && pwd -P) || primary_error="cannot canonicalize git common dir"
fi
if [ -z "$primary_error" ]; then
    if [ "$git_dir_abs" = "$common_dir_abs" ]; then
        primary_state=primary
    else
        primary_state=linked
    fi
fi

root=""
cwd=$(pwd -P 2>/dev/null) || cwd="<unknown>"
zero=0000000000000000000000000000000000000000

json_escape() {
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

record_violation() {
    blocked_ref=$1
    blocked_old=$2
    blocked_new=$3
    blocked_kind=$4
    blocked_reason=$5
    guard_dir=$root/coordination/runtime/guard
    guard_file=$guard_dir/violations.jsonl
    ts=$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null) || ts="<unknown>"

    if ! mkdir -p "$guard_dir"; then
        echo "orch main guard: BLOCK: $blocked_reason; cannot create $guard_dir" >&2
        return 1
    fi
    escaped_ts=$(json_escape "$ts")
    escaped_ref=$(json_escape "$blocked_ref")
    escaped_old=$(json_escape "$blocked_old")
    escaped_new=$(json_escape "$blocked_new")
    escaped_kind=$(json_escape "$blocked_kind")
    escaped_cwd=$(json_escape "$cwd")
    escaped_reason=$(json_escape "$blocked_reason")
    if ! printf '{"ts":"%s","refname":"%s","old":"%s","new":"%s","kind":"%s","cwd":"%s","reason":"%s"}\n' \
        "$escaped_ts" "$escaped_ref" "$escaped_old" "$escaped_new" "$escaped_kind" "$escaped_cwd" "$escaped_reason" \
        >>"$guard_file"
    then
        echo "orch main guard: BLOCK: $blocked_reason; cannot append $guard_file" >&2
        return 1
    fi
    echo "orch main guard: BLOCK: $blocked_reason" >&2
    return 0
}

resolve_primary_root() {
    if [ "$primary_state" = "linked" ]; then
        return 1
    fi
    if [ "$primary_state" != "primary" ]; then
        echo "orch main guard: BLOCK: $primary_error (fail-closed)" >&2
        return 2
    fi
    root=$(git rev-parse --show-toplevel 2>/dev/null) || {
        echo "orch main guard: BLOCK: cannot resolve primary worktree root (fail-closed)" >&2
        return 2
    }
    return 0
}

# `git worktree add` starts the new linked worktree's HEAD transaction while
# the hook still runs from the primary checkout.  Git does not export the
# target worktree's git-dir to this hook, so cwd identity alone would confuse
# legitimate provisioning with a primary checkout.  The initializing admin
# record is the transaction-local discriminator: the primary HEAD lock must be
# absent, and exactly one non-symlink linked admin directory must carry Git's
# `locked=initializing` marker plus a HEAD.lock containing this exact target.
initializing_linked_head_update() {
    transaction_old=$1
    transaction_new=$2

    if [ "$transaction_old" != "$zero" ] || [ "$transaction_new" = "$zero" ]; then
        return 1
    fi
    if [ -e "$common_dir_abs/HEAD.lock" ] || [ -L "$common_dir_abs/HEAD.lock" ]; then
        return 1
    fi

    worktrees_dir=$common_dir_abs/worktrees
    if [ ! -d "$worktrees_dir" ] || [ -L "$worktrees_dir" ]; then
        return 1
    fi

    initializing_matches=0
    for linked_admin in "$worktrees_dir"/*
    do
        if [ ! -d "$linked_admin" ] || [ -L "$linked_admin" ]; then
            continue
        fi
        linked_lock=$linked_admin/locked
        linked_head_lock=$linked_admin/HEAD.lock
        if [ ! -f "$linked_lock" ] || [ -L "$linked_lock" ] || \
           [ ! -f "$linked_head_lock" ] || [ -L "$linked_head_lock" ]; then
            continue
        fi

        linked_lock_lines=$(wc -l <"$linked_lock" 2>/dev/null | tr -d '[:space:]') || continue
        linked_lock_bytes=$(wc -c <"$linked_lock" 2>/dev/null | tr -d '[:space:]') || continue
        linked_head_lines=$(wc -l <"$linked_head_lock" 2>/dev/null | tr -d '[:space:]') || continue
        linked_head_bytes=$(wc -c <"$linked_head_lock" 2>/dev/null | tr -d '[:space:]') || continue
        case "$linked_lock_lines:$linked_lock_bytes:$linked_head_lines:$linked_head_bytes" in
            *[!0-9:]*) continue ;;
        esac

        IFS= read -r linked_lock_value <"$linked_lock" || continue
        IFS= read -r linked_head_value <"$linked_head_lock" || continue
        # H143: git reports a symbolic-ref transaction as `ref:<target>` while
        # the on-disk HEAD lock stores git's file syntax `ref: <target>`.
        # Comparing the raw transaction value against the file therefore never
        # matched for a branch worktree, so every `git worktree add -b` was
        # misread as a primary HEAD update and blocked (20 recorded hits since
        # 2026-08-06: task/B233, B240, B252, B255).  Normalise to the file
        # syntax before comparing.  Detached initialisation keeps comparing the
        # raw object id exactly as before.
        case "$transaction_new" in
            "ref: "*)
                expected_head_value="ref: ${transaction_new#ref: }"
                ;;
            "ref:"*)
                expected_head_value="ref: ${transaction_new#ref:}"
                ;;
            *)
                expected_head_value=$transaction_new
                ;;
        esac
        expected_head_bytes=$((${#expected_head_value} + 1))
        if [ "$linked_lock_lines" -ne 1 ] || [ "$linked_lock_bytes" -ne 13 ] || \
           [ "$linked_lock_value" != "initializing" ] || \
           [ "$linked_head_lines" -ne 1 ] || [ "$linked_head_bytes" -ne "$expected_head_bytes" ] || \
           [ "$linked_head_value" != "$expected_head_value" ]; then
            continue
        fi

        initializing_matches=$((initializing_matches + 1))
        if [ "$initializing_matches" -gt 1 ]; then
            return 1
        fi
    done

    [ "$initializing_matches" -eq 1 ]
}

# B204: The barrier is security-sensitive and must not infer state with greedy
# regexes.  Parse the complete active JSONL ledger, reject malformed/ambiguous
# input, and expose only separator-safe identities to the shell caller.
pending_verdict_barrier() {
    transaction_old=$1
    current_round_file=$root/coordination/runtime/CURRENT-ROUND
    if [ ! -e "$current_round_file" ]; then
        return 1
    fi
    if [ ! -f "$current_round_file" ] || [ -L "$current_round_file" ]; then
        echo "CURRENT-ROUND is not a regular non-symlink file"
        return 2
    fi
    current_round_lines=$(wc -l <"$current_round_file" 2>/dev/null | tr -d '[:space:]') || {
        echo "cannot read CURRENT-ROUND"
        return 2
    }
    current_round_bytes=$(wc -c <"$current_round_file" 2>/dev/null | tr -d '[:space:]') || {
        echo "cannot read CURRENT-ROUND"
        return 2
    }
    IFS= read -r current_round <"$current_round_file" || {
        echo "CURRENT-ROUND must be one newline-terminated line"
        return 2
    }
    case "$current_round_lines:$current_round_bytes" in
        *[!0-9:]*|:*|*:) echo "CURRENT-ROUND size metadata is invalid"; return 2 ;;
    esac
    expected_round_bytes=$((${#current_round} + 1))
    if [ "$current_round_lines" -ne 1 ] || [ "$current_round_bytes" -ne "$expected_round_bytes" ]; then
        echo "CURRENT-ROUND must be exactly one newline-terminated line"
        return 2
    fi
    case "$current_round" in
        r*) round_digits=${current_round#r} ;;
        *) echo "CURRENT-ROUND must match r<positive integer>"; return 2 ;;
    esac
    case "$round_digits" in
        ""|0*|*[!0-9]*) echo "CURRENT-ROUND must match r<positive integer>"; return 2 ;;
    esac

    ledger_file=$root/coordination/rounds/$current_round/events.jsonl
    if [ ! -f "$ledger_file" ] || [ -L "$ledger_file" ] || [ ! -r "$ledger_file" ]; then
        echo "active round ledger is missing, unreadable, or not a regular non-symlink file"
        return 2
    fi
    ledger_lines=$(wc -l <"$ledger_file" 2>/dev/null | tr -d '[:space:]') || {
        echo "cannot read active round ledger"
        return 2
    }
    case "$ledger_lines" in
        ""|*[!0-9]*) echo "active round ledger line count is invalid"; return 2 ;;
        0) echo "active round ledger is empty"; return 2 ;;
    esac

    # The ledger carries non-ASCII payload text (reasons, escalation messages).
    # Under a UTF-8 locale macOS awk aborts such input with
    #   awk: towc: multibyte conversion failure
    # which this guard would then correctly, but uselessly, turn into a
    # fail-closed BLOCK of every refs/heads/main update — including orch's own
    # merge. LC_ALL=C makes awk byte-oriented; every token this parser matches
    # (JSON keys, SHAs, event kinds) is ASCII, so byte semantics are sufficient
    # and non-ASCII payload bytes simply pass through untouched.
    barrier_detail=$(LC_ALL=C awk -v expected_lines="$ledger_lines" -v current_round="$current_round" \
        -v transaction_old="$transaction_old" '
        function reject(message) {
            if (parse_error == "") {
                parse_error = message
                parse_error_line = NR
            }
            return 0
        }

        function clear_record(    key) {
            for (key in object_seen) delete object_seen[key]
            for (key in top_present) delete top_present[key]
            for (key in top_type) delete top_type[key]
            for (key in top_string) delete top_string[key]
            for (key in top_escaped) delete top_escaped[key]
            for (key in top_number) delete top_number[key]
            for (key in payload_present) delete payload_present[key]
            for (key in payload_type) delete payload_type[key]
            for (key in payload_string) delete payload_string[key]
            for (key in payload_escaped) delete payload_escaped[key]
            for (key in payload_number) delete payload_number[key]
            for (key in payload_array_count) delete payload_array_count[key]
            for (key in payload_array_nonempty_strings) delete payload_array_nonempty_strings[key]
            top_count = 0
            payload_count = 0
            object_serial = 0
            parse_error = ""
            parse_error_line = 0
        }

        function unicode_escape_is_whitespace(code,    lower) {
            lower = tolower(code)
            return lower == "0009" || lower == "000a" || lower == "000b" ||
                   lower == "000c" || lower == "000d" || lower == "0020" ||
                   lower == "0085" || lower == "00a0" || lower == "1680" ||
                   lower == "2000" || lower == "2001" || lower == "2002" ||
                   lower == "2003" || lower == "2004" || lower == "2005" ||
                   lower == "2006" || lower == "2007" || lower == "2008" ||
                   lower == "2009" || lower == "200a" || lower == "2028" ||
                   lower == "2029" || lower == "202f" || lower == "205f" ||
                   lower == "3000"
        }

        function init_ord(    ord_i) {
            if (ord_ready) return
            for (ord_i = 0; ord_i < 256; ord_i++) ORD[sprintf("%c", ord_i)] = ord_i
            ord_ready = 1
        }

        function parse_string(    character, escaped, code, lead, seq_len, cont, cont_i, code_point) {
            init_ord()
            if (substr(json_text, json_pos, 1) != "\"")
                return reject("contains an invalid JSON string")
            json_pos++
            parsed_string = ""
            parsed_escaped = 0
            while (json_pos <= json_length) {
                character = substr(json_text, json_pos, 1)
                if (character == "\"") {
                    json_pos++
                    parsed_type = "string"
                    return 1
                }
                if (character == "\\") {
                    parsed_escaped = 1
                    json_pos++
                    if (json_pos > json_length)
                        return reject("contains an unterminated JSON escape")
                    escaped = substr(json_text, json_pos, 1)
                    if (escaped == "u") {
                        code = substr(json_text, json_pos + 1, 4)
                        if (length(code) != 4 || code !~ /^[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]$/)
                            return reject("contains an invalid JSON unicode escape")
                        parsed_string = parsed_string (unicode_escape_is_whitespace(code) ? " " : "?")
                        json_pos += 5
                        continue
                    }
                    if (escaped != "\"" && escaped != "\\" && escaped != "/" &&
                        escaped != "b" && escaped != "f" && escaped != "n" &&
                        escaped != "r" && escaped != "t")
                        return reject("contains an invalid JSON escape")
                    if (escaped == "f" || escaped == "n" || escaped == "r" || escaped == "t")
                        parsed_string = parsed_string " "
                    else
                        parsed_string = parsed_string "?"
                    json_pos++
                    continue
                }
                if (character ~ /[[:cntrl:]]/)
                    return reject("contains an unescaped JSON control character")
                lead = ORD[character]
                if (lead >= 128) {
                    # Raw UTF-8 must go through the SAME whitespace whitelist as
                    # the \uXXXX escape path above, otherwise a reason holding
                    # only a raw U+3000 reads as blank to the Rust str::trim() judge but
                    # as non-blank here — which would let a crafted terminal
                    # clear a pending root PASS in the hook while the Rust
                    # domain judge rejects it. Decoding here also restores the
                    # bad-line fail-closed guarantee that LC_ALL=C removed:
                    # malformed UTF-8 is a parse error, not "valid, no barrier".
                    if (lead >= 194 && lead <= 223) seq_len = 2
                    else if (lead >= 224 && lead <= 239) seq_len = 3
                    else if (lead >= 240 && lead <= 244) seq_len = 4
                    else return reject("contains a malformed UTF-8 lead byte")
                    if (json_pos + seq_len - 1 > json_length)
                        return reject("contains a truncated UTF-8 sequence")
                    code_point = lead
                    if (seq_len == 2) code_point = lead - 192
                    else if (seq_len == 3) code_point = lead - 224
                    else code_point = lead - 240
                    for (cont_i = 1; cont_i < seq_len; cont_i++) {
                        cont = ORD[substr(json_text, json_pos + cont_i, 1)]
                        if (cont < 128 || cont > 191)
                            return reject("contains a malformed UTF-8 continuation byte")
                        code_point = code_point * 64 + (cont - 128)
                    }
                    if (seq_len == 2 && code_point < 128)
                        return reject("contains an overlong UTF-8 sequence")
                    if (seq_len == 3 && code_point < 2048)
                        return reject("contains an overlong UTF-8 sequence")
                    if (seq_len == 4 && code_point < 65536)
                        return reject("contains an overlong UTF-8 sequence")
                    if (code_point >= 55296 && code_point <= 57343)
                        return reject("contains a UTF-8 encoded surrogate")
                    if (code_point > 1114111)
                        return reject("contains an out-of-range UTF-8 code point")
                    parsed_string = parsed_string \
                        (unicode_escape_is_whitespace(sprintf("%04x", code_point)) ? " " : "?")
                    json_pos += seq_len
                    continue
                }
                parsed_string = parsed_string character
                json_pos++
            }
            return reject("contains an unterminated JSON string")
        }

        function parse_number(    rest, token) {
            rest = substr(json_text, json_pos)
            if (match(rest, /^-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?/) != 1)
                return reject("contains an invalid JSON number")
            token = substr(rest, 1, RLENGTH)
            json_pos += RLENGTH
            parsed_type = "number"
            parsed_number = token
            parsed_string = ""
            parsed_escaped = 0
            return 1
        }

        function parse_array(    character, count, all_nonempty_strings, value_type, value_string) {
            json_pos++
            count = 0
            all_nonempty_strings = 1
            if (substr(json_text, json_pos, 1) == "]") {
                json_pos++
                parsed_type = "array"
                parsed_array_count = 0
                parsed_array_nonempty_strings = 1
                return 1
            }
            while (json_pos <= json_length) {
                if (!parse_value(0)) return 0
                value_type = parsed_type
                value_string = parsed_string
                count++
                if (value_type != "string" || value_string == "")
                    all_nonempty_strings = 0
                character = substr(json_text, json_pos, 1)
                if (character == "]") {
                    json_pos++
                    parsed_type = "array"
                    parsed_array_count = count
                    parsed_array_nonempty_strings = all_nonempty_strings
                    parsed_string = ""
                    parsed_escaped = 0
                    return 1
                }
                if (character != ",")
                    return reject("contains a malformed JSON array")
                json_pos++
            }
            return reject("contains an unterminated JSON array")
        }

        function remember_value(mode, key, value_type, value_string, value_escaped,
                                value_number, value_array_count, value_array_nonempty_strings) {
            if (mode == 1) {
                top_present[key] = 1
                top_type[key] = value_type
                top_string[key] = value_string
                top_escaped[key] = value_escaped
                top_number[key] = value_number
                top_count++
            } else if (mode == 2) {
                payload_present[key] = 1
                payload_type[key] = value_type
                payload_string[key] = value_string
                payload_escaped[key] = value_escaped
                payload_number[key] = value_number
                payload_array_count[key] = value_array_count
                payload_array_nonempty_strings[key] = value_array_nonempty_strings
                payload_count++
            }
        }

        function parse_object(mode,    object_id, character, key, child_mode,
                              value_type, value_string, value_escaped, value_number,
                              value_array_count, value_array_nonempty_strings) {
            json_pos++
            object_id = ++object_serial
            if (substr(json_text, json_pos, 1) == "}") {
                json_pos++
                parsed_type = "object"
                parsed_string = ""
                parsed_escaped = 0
                return 1
            }
            while (json_pos <= json_length) {
                if (!parse_string()) return 0
                if (parsed_escaped)
                    return reject("contains an escaped object key")
                key = parsed_string
                if ((object_id SUBSEP key) in object_seen)
                    return reject("contains duplicate object key " key)
                object_seen[object_id, key] = 1
                if (substr(json_text, json_pos, 1) != ":")
                    return reject("contains a malformed JSON object")
                json_pos++
                child_mode = (mode == 1 && key == "payload") ? 2 : 0
                if (!parse_value(child_mode)) return 0
                value_type = parsed_type
                value_string = parsed_string
                value_escaped = parsed_escaped
                value_number = parsed_number
                value_array_count = parsed_array_count
                value_array_nonempty_strings = parsed_array_nonempty_strings
                remember_value(mode, key, value_type, value_string, value_escaped,
                               value_number, value_array_count, value_array_nonempty_strings)
                character = substr(json_text, json_pos, 1)
                if (character == "}") {
                    json_pos++
                    parsed_type = "object"
                    parsed_string = ""
                    parsed_escaped = 0
                    return 1
                }
                if (character != ",")
                    return reject("contains a malformed JSON object")
                json_pos++
            }
            return reject("contains an unterminated JSON object")
        }

        function parse_value(mode,    character, literal) {
            parsed_type = ""
            parsed_string = ""
            parsed_escaped = 0
            parsed_number = ""
            parsed_array_count = 0
            parsed_array_nonempty_strings = 0
            character = substr(json_text, json_pos, 1)
            if (character == "\"") return parse_string()
            if (character == "{") return parse_object(mode)
            if (character == "[") return parse_array()
            if (character == "-" || character ~ /[0-9]/) return parse_number()
            literal = substr(json_text, json_pos, 5)
            if (substr(literal, 1, 4) == "true") {
                json_pos += 4
                parsed_type = "boolean"
                return 1
            }
            if (substr(literal, 1, 5) == "false") {
                json_pos += 5
                parsed_type = "boolean"
                return 1
            }
            if (substr(literal, 1, 4) == "null") {
                json_pos += 4
                parsed_type = "null"
                return 1
            }
            return reject("contains an invalid JSON value")
        }

        function safe_id(value) {
            return value != "" && value ~ /^[A-Za-z0-9._:-]+$/ && index(value, "|") == 0
        }

        function full_sha(value) {
            return length(value) == 40 && value ~ /^[0-9a-f]+$/
        }

        function full_digest(value) {
            return length(value) == 64 && value ~ /^[0-9a-f]+$/
        }

        function positive_integer(value) {
            return value ~ /^[1-9][0-9]*$/
        }

        function canonical_task(value) {
            return value ~ /^B[1-9][0-9]*$/
        }

        function attempt_ordinal(attempt, task,    prefix, digits, ordinal) {
            prefix = task "-A"
            if (index(attempt, prefix) != 1) return 0
            digits = substr(attempt, length(prefix) + 1)
            if (digits !~ /^[0-9][0-9][0-9][0-9]+$/) return 0
            ordinal = digits + 0
            if (ordinal < 1 || sprintf("%04d", ordinal) != digits) return 0
            return ordinal
        }

        function direct_string(scope, key) {
            if (scope == "top")
                return top_present[key] && top_type[key] == "string" && !top_escaped[key]
            return payload_present[key] && payload_type[key] == "string" && !payload_escaped[key]
        }

        function allowed_top_key(key) {
            return key == "eventId" || key == "ts" || key == "actor" || key == "type" ||
                   key == "taskId" || key == "round" || key == "payload" ||
                   key == "plannerWakeId" || key == "initiatorKind" ||
                   key == "invocationMode" || key == "modelWakeReservationId"
        }

        function validate_envelope(    key, event_id) {
            for (key in top_present)
                if (!allowed_top_key(key)) return reject("has an unknown event envelope key " key)
            if (!direct_string("top", "eventId") || !direct_string("top", "ts") ||
                !direct_string("top", "actor") || !direct_string("top", "type") ||
                !direct_string("top", "round") || top_type["payload"] != "object")
                return reject("is not a canonical event envelope")
            if (top_present["taskId"] && !direct_string("top", "taskId"))
                return reject("has a non-string taskId")
            if (top_present["plannerWakeId"] &&
                (!direct_string("top", "plannerWakeId") || !safe_id(top_string["plannerWakeId"])))
                return reject("has an unsafe plannerWakeId")
            if (top_present["modelWakeReservationId"] &&
                (!direct_string("top", "modelWakeReservationId") || !safe_id(top_string["modelWakeReservationId"])))
                return reject("has an unsafe modelWakeReservationId")
            if (top_present["initiatorKind"] &&
                (!direct_string("top", "initiatorKind") || !safe_id(top_string["initiatorKind"])))
                return reject("has an unsafe initiatorKind")
            if (top_present["invocationMode"] &&
                (!direct_string("top", "invocationMode") || !safe_id(top_string["invocationMode"])))
                return reject("has an unsafe invocationMode")
            if (!safe_id(top_string["eventId"]) || !safe_id(top_string["actor"]) ||
                !safe_id(top_string["type"]) ||
                (top_present["taskId"] && !safe_id(top_string["taskId"])))
                return reject("contains an unsafe identity or output separator")
            if (top_string["ts"] == "" || index(top_string["ts"], "|") != 0)
                return reject("has an invalid timestamp identity")
            if (top_string["round"] != current_round)
                return reject("claims the wrong round")
            event_id = top_string["eventId"]
            if (event_id in event_ids)
                return reject("duplicates eventId " event_id)
            event_ids[event_id] = 1
            return 1
        }

        function root_payload_key(key) {
            return key == "attemptId" || key == "attemptNo" ||
                   key == "collectCompletedEventId" || key == "evidence" ||
                   key == "gates" || key == "headSha" ||
                   key == "implementerAgent" || key == "irRevision" ||
                   key == "mainHeadSha" || key == "reviews" ||
                   key == "validationDigest" || key == "verdict" ||
                   key == "reason" || key == "bootstrapPreSignoffAttempt"
        }

        function validate_root_verdict(task,    key, verdict, attempt, ordinal, expected_count, reason) {
            for (key in payload_present)
                if (!root_payload_key(key)) return reject("root VerdictIssued has unknown payload key " key)
            if (!payload_present["attemptId"] || !payload_present["attemptNo"] ||
                !payload_present["collectCompletedEventId"] || !payload_present["evidence"] ||
                !payload_present["gates"] || !payload_present["headSha"] ||
                !payload_present["implementerAgent"] || !payload_present["irRevision"] ||
                !payload_present["mainHeadSha"] || !payload_present["reviews"] ||
                !payload_present["validationDigest"] || !payload_present["verdict"])
                return reject("root VerdictIssued payload lacks required keys")
            expected_count = 12
            if (payload_present["reason"]) expected_count++
            if (payload_present["bootstrapPreSignoffAttempt"]) expected_count++
            if (payload_count != expected_count)
                return reject("root VerdictIssued payload key set is not exact")
            if (!direct_string("payload", "attemptId") ||
                !direct_string("payload", "collectCompletedEventId") ||
                !direct_string("payload", "headSha") ||
                !direct_string("payload", "implementerAgent") ||
                !direct_string("payload", "mainHeadSha") ||
                !direct_string("payload", "validationDigest") ||
                !direct_string("payload", "verdict"))
                return reject("root VerdictIssued has a non-canonical string binding")
            if (payload_type["attemptNo"] != "number" ||
                payload_type["irRevision"] != "number" ||
                payload_type["reviews"] != "array" ||
                payload_type["evidence"] != "array" || payload_type["gates"] != "array")
                return reject("root VerdictIssued has a non-canonical typed binding")
            attempt = payload_string["attemptId"]
            ordinal = attempt_ordinal(attempt, task)
            if (!canonical_task(task) || !ordinal || payload_number["attemptNo"] != ordinal ||
                !positive_integer(payload_number["attemptNo"]) ||
                !positive_integer(payload_number["irRevision"]))
                return reject("root VerdictIssued task/attempt/ordinal is not canonical")
            if (!safe_id(attempt) || !safe_id(payload_string["collectCompletedEventId"]) ||
                !safe_id(payload_string["implementerAgent"]) ||
                !full_sha(payload_string["headSha"]) ||
                !full_sha(payload_string["mainHeadSha"]) ||
                !full_digest(payload_string["validationDigest"]))
                return reject("root VerdictIssued identity/hash binding is invalid")
            if (payload_present["bootstrapPreSignoffAttempt"] &&
                (!direct_string("payload", "bootstrapPreSignoffAttempt") ||
                 !safe_id(payload_string["bootstrapPreSignoffAttempt"])))
                return reject("root VerdictIssued bootstrap binding is invalid")
            verdict = payload_string["verdict"]
            if (verdict != "PASS" && verdict != "FAIL" && verdict != "BLOCKED")
                return reject("root VerdictIssued verdict is invalid")
            if (verdict == "PASS") {
                if (payload_present["reason"])
                    return reject("root PASS must not carry reason")
            } else {
                if (payload_type["reason"] != "string")
                    return reject("root FAIL/BLOCKED must carry reason")
                reason = payload_string["reason"]
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", reason)
                if (reason == "") return reject("root FAIL/BLOCKED reason is blank")
            }
            return 1
        }

        function validate_merge_started(task,    attempt, ordinal) {
            if (payload_count != 6 || !payload_present["attemptId"] ||
                !payload_present["attemptNo"] || !payload_present["collectCompletedEventId"] ||
                !payload_present["headSha"] || !payload_present["mainHeadSha"] ||
                !payload_present["verdictEventId"])
                return reject("MergeStarted payload key set is not exact")
            if (!direct_string("payload", "attemptId") ||
                !direct_string("payload", "collectCompletedEventId") ||
                !direct_string("payload", "headSha") ||
                !direct_string("payload", "mainHeadSha") ||
                !direct_string("payload", "verdictEventId") ||
                payload_type["attemptNo"] != "number")
                return reject("MergeStarted payload types are not canonical")
            attempt = payload_string["attemptId"]
            ordinal = attempt_ordinal(attempt, task)
            if (!ordinal || !positive_integer(payload_number["attemptNo"]) ||
                payload_number["attemptNo"] != ordinal || !safe_id(attempt) ||
                !safe_id(payload_string["collectCompletedEventId"]) ||
                !safe_id(payload_string["verdictEventId"]) ||
                !full_sha(payload_string["headSha"]) || !full_sha(payload_string["mainHeadSha"]))
                return reject("MergeStarted payload identities are invalid")
            return 1
        }

        function validate_approved_reattempt(task,    attempt, ordinal, reason, key) {
            if (payload_count != 6 || !payload_present["agent"] ||
                !payload_present["attemptId"] || !payload_present["attemptNo"] ||
                !payload_present["reason"] || !payload_present["stage"] ||
                !payload_present["verdictEventId"])
                return reject("approved-reattempt payload key set is not exact")
            if (!direct_string("payload", "agent") || !direct_string("payload", "attemptId") ||
                payload_type["attemptNo"] != "number" || payload_type["reason"] != "string" ||
                !direct_string("payload", "stage") || !direct_string("payload", "verdictEventId"))
                return reject("approved-reattempt payload types are not canonical")
            attempt = payload_string["attemptId"]
            ordinal = attempt_ordinal(attempt, task)
            reason = payload_string["reason"]
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", reason)
            if (!ordinal || payload_number["attemptNo"] != ordinal ||
                !positive_integer(payload_number["attemptNo"]) || !safe_id(attempt) ||
                !safe_id(payload_string["agent"]) || !safe_id(payload_string["verdictEventId"]) ||
                payload_string["stage"] != "approved-reattempt" || reason == "")
                return reject("approved-reattempt payload identities are invalid")
            return 1
        }

        function validate_merge_closure_terminal(task,    attempt, ordinal, reason) {
            if (payload_count != 5 || !payload_present["agent"] ||
                !payload_present["attemptId"] || !payload_present["attemptNo"] ||
                !payload_present["reason"] || !payload_present["stage"])
                return reject("merge closure AttemptBlocked payload key set is not exact")
            if (!direct_string("payload", "agent") ||
                !direct_string("payload", "attemptId") ||
                payload_type["attemptNo"] != "number" ||
                payload_type["reason"] != "string" ||
                !direct_string("payload", "stage"))
                return reject("merge closure AttemptBlocked payload types are not canonical")
            attempt = payload_string["attemptId"]
            ordinal = attempt_ordinal(attempt, task)
            reason = payload_string["reason"]
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", reason)
            if (!ordinal || payload_number["attemptNo"] != ordinal ||
                !positive_integer(payload_number["attemptNo"]) || !safe_id(attempt) ||
                !safe_id(payload_string["agent"]) ||
                payload_string["stage"] != "merge-conflict" || reason == "")
                return reject("merge closure AttemptBlocked identities are invalid")
            return 1
        }

        function process_event(    kind, actor, task, verdict, stage) {
            kind = top_string["type"]
            actor = top_string["actor"]
            task = top_present["taskId"] ? top_string["taskId"] : ""
            stage = ""
            if (("stage" in payload_present) && direct_string("payload", "stage"))
                stage = payload_string["stage"]

            # close.rs publishes a no-merge closure and its attempt terminal
            # in one B205 batch, hence their ledger lines are adjacent.  Do
            # not disarm the main barrier on the escalation half alone.
            if (pending_closure) {
                if (kind != "AttemptBlocked" || actor != "runtime:orch" ||
                    task == "" || task != pending_task ||
                    !validate_merge_closure_terminal(task) ||
                    payload_string["attemptId"] != pending_attempt ||
                    payload_number["attemptNo"] != pending_attempt_no ||
                    payload_string["agent"] != pending_agent)
                    return reject("merge barrier closure lacks adjacent exact AttemptBlocked")
                pending_closure = 0
                pending_task = ""
                pending_started = 0
                return 1
            }

            if (kind == "VerdictIssued") {
                if (actor != "verifier:root" || task == "")
                    return reject("VerdictIssued envelope is not canonical root authority")
                if (!validate_root_verdict(task)) return 0
                verdict = payload_string["verdict"]
                if (verdict == "PASS") {
                    if (pending_task != "") return reject("multiple unresolved root PASS verdicts")
                    pending_task = task
                    pending_attempt = payload_string["attemptId"]
                    pending_attempt_no = payload_number["attemptNo"]
                    pending_agent = payload_string["implementerAgent"]
                    pending_collect = payload_string["collectCompletedEventId"]
                    pending_event = top_string["eventId"]
                    pending_head = payload_string["headSha"]
                    pending_main = payload_string["mainHeadSha"]
                    pending_started = 0
                }
                return 1
            }

            if (kind == "MergeStarted") {
                if (actor != "runtime:orch" || task == "")
                    return reject("MergeStarted envelope is not canonical runtime authority")
                if (!validate_merge_started(task)) return 0
                if (pending_task == "" || pending_started || task != pending_task ||
                    payload_string["attemptId"] != pending_attempt ||
                    payload_number["attemptNo"] != pending_attempt_no ||
                    payload_string["collectCompletedEventId"] != pending_collect ||
                    payload_string["headSha"] != pending_head ||
                    payload_string["mainHeadSha"] != pending_main ||
                    payload_string["verdictEventId"] != pending_event)
                    return reject("MergeStarted does not exactly bind pending root PASS")
                pending_started = 1
                return 1
            }

            if (kind == "MergeExecuted") {
                if (actor != "reviewer:orch-runtime" || task == "" || payload_count != 2 ||
                    !payload_present["mergeSha"] || !payload_present["policy"] ||
                    !direct_string("payload", "mergeSha") || !direct_string("payload", "policy") ||
                    !full_sha(payload_string["mergeSha"]) || payload_string["policy"] != "no-ff")
                    return reject("MergeExecuted envelope/payload is not canonical")
                if (pending_task == "" || !pending_started || task != pending_task)
                    return reject("MergeExecuted does not canonically close pending root PASS")
                pending_task = ""
                pending_started = 0
                return 1
            }

            if (kind == "AttemptBlocked" && stage == "approved-reattempt") {
                if (actor != "runtime:orch" || task == "" || !validate_approved_reattempt(task))
                    return reject("approved-reattempt envelope is not canonical")
                if (pending_task == "" || pending_started || task != pending_task ||
                    payload_string["attemptId"] != pending_attempt ||
                    payload_number["attemptNo"] != pending_attempt_no ||
                    payload_string["agent"] != pending_agent ||
                    payload_string["verdictEventId"] != pending_event)
                    return reject("approved-reattempt does not exactly bind pending root PASS")
                pending_task = ""
                pending_started = 0
                return 1
            }
            if (kind == "AttemptBlocked" && pending_task != "" && task == pending_task) {
                # H99 (r62/B204, on the very merge that installed this hook):
                # an attempt can be terminally blocked AFTER its root PASS and
                # BEFORE any MergeStarted -- the executor files honest blocked
                # evidence, or H98 voids the verdict through a compile-input
                # change on main. r62 ledger lines 406-408 are exactly that
                # shape, and this arm used to fail-closed the whole guard on
                # them, freezing every refs/heads/main update for the rest of
                # the round (including the merge that installs this file).
                #
                # Such an attempt can never reach merge: the verdict is
                # exactly-once and the attempt is terminal. Its PASS therefore
                # must not hold main hostage. Requiring the terminal to name
                # the pending attempt keeps this from disarming a barrier that
                # belongs to some other attempt.
                #
                # An ARMED barrier (pending_started) is untouched: once
                # MergeStarted is on the ledger the merge may really have run,
                # so closure still has to come from MergeExecuted or from the
                # adjacent merge-conflict / barrier-recovered pair above.
                # The bindings below match what the sibling arms demand, so this
                # path is not a weaker way in. `stage` is only assigned when it
                # is a direct (unescaped) string, so a terminal carrying an
                # escaped stage would otherwise fall past the strict arm above
                # and land here; reject that outright rather than let an escape
                # sequence pick the laxer check.
                if (("stage" in payload_present) && !direct_string("payload", "stage"))
                    return reject("AttemptBlocked stage is not a direct string")
                if (!pending_started && actor == "runtime:orch" &&
                    direct_string("payload", "attemptId") &&
                    payload_string["attemptId"] == pending_attempt &&
                    payload_type["attemptNo"] == "number" &&
                    payload_number["attemptNo"] == pending_attempt_no &&
                    direct_string("payload", "agent") &&
                    payload_string["agent"] == pending_agent) {
                    pending_task = ""
                    pending_started = 0
                    return 1
                }
                return reject("non-terminal AttemptBlocked cannot clear pending root PASS")
            }

            if (kind == "EscalationRaised" &&
                (stage == "merge-conflict" || stage == "barrier-recovered")) {
                if (actor != "reviewer:orch-runtime" || task == "" ||
                    pending_task == "" || !pending_started || task != pending_task)
                    return reject("barrier closure does not bind pending root PASS")
                if (stage == "merge-conflict") {
                    if (payload_count != 3 || !payload_present["conflictFiles"] ||
                        payload_type["conflictFiles"] != "array" ||
                        !payload_array_nonempty_strings["conflictFiles"] ||
                        payload_type["mergeSha"] != "null" ||
                        !direct_string("payload", "stage"))
                        return reject("merge-conflict closure payload is not canonical")
                } else if (payload_count != 1 || !direct_string("payload", "stage")) {
                    return reject("barrier-recovered closure payload is not canonical")
                }
                pending_closure = 1
            }
            return 1
        }

        {
            clear_record()
            json_text = $0
            json_length = length(json_text)
            json_pos = 1
            if (json_length == 0) {
                reject("is blank")
                exit 2
            }
            if (!parse_value(1) || parsed_type != "object" || json_pos != json_length + 1) {
                if (parse_error == "") reject("is not exactly one canonical JSON object")
                exit 2
            }
            if (!validate_envelope() || !process_event()) exit 2
        }

        END {
            if (parse_error != "") {
                print "active ledger line " parse_error_line " " parse_error
                exit 2
            }
            if (NR != expected_lines) {
                print "active round ledger is truncated or changed while reading"
                exit 2
            }
            if (pending_closure) {
                print "pending merge barrier closure lacks adjacent exact AttemptBlocked"
                exit 2
            }
            if (pending_task != "") {
                if (pending_started && pending_main != transaction_old) {
                    print "pending MergeStarted.mainHeadSha does not equal transaction old SHA"
                    exit 2
                }
                print pending_task "|" pending_attempt "|" pending_event "|" pending_head "|" \
                      (pending_started ? "true" : "false")
                exit 0
            }
            exit 1
        }
    ' "$ledger_file")
    barrier_status=$?
    case "$barrier_status" in
        0) printf '%s\n' "$barrier_detail"; return 0 ;;
        1) return 1 ;;
        *)
            if [ -z "$barrier_detail" ]; then
                barrier_detail="cannot parse active round ledger"
            fi
            printf '%s\n' "$barrier_detail"
            return 2
            ;;
    esac
}

while read -r old new refname
do
    if [ "$bypass_main_guard" = "true" ]; then
        if [ "$refname" = "HEAD" ]; then
            echo "orch main guard: BYPASS: ORCH_MAIN_GUARD_BYPASS=1 allows HEAD update old=$old new=$new" >&2
        fi
        continue
    fi

    if [ "$refname" = "HEAD" ]; then
        resolve_primary_root
        primary_status=$?
        if [ "$primary_status" -eq 1 ]; then
            # A linked worktree owns its own HEAD. Detached review worktrees
            # depend on these updates during provisioning and checkout.
            continue
        fi
        if [ "$primary_status" -ne 0 ]; then
            exit 1
        fi
        if initializing_linked_head_update "$old" "$new"; then
            continue
        fi
        reason="HEAD update in primary worktree old=$old new=$new"
        record_violation "$refname" "$old" "$new" "primary-head" "$reason"
        exit 1
    fi

    if [ "$refname" != "refs/stash" ] && [ "$refname" != "refs/heads/main" ]; then
        continue
    fi

    resolve_primary_root
    primary_status=$?
    if [ "$primary_status" -eq 1 ]; then
        # Linked worktrees share refs with the primary checkout.  They may
        # update their own topic refs, but a transaction that explicitly
        # reaches refs/heads/main (or refs/stash) is repository-wide and must
        # never bypass the primary guard merely because its cwd is linked.
        # We cannot safely bind a linked checkout's potentially different
        # coordination tree to primary-main state, so reject protected-ref
        # updates fail-closed and leave evidence in the linked checkout.
        root=$(git rev-parse --show-toplevel 2>/dev/null) || {
            echo "orch main guard: BLOCK: protected ref update from linked worktree; cannot resolve evidence root (fail-closed)" >&2
            exit 1
        }
        reason="$refname update from linked worktree old=$old new=$new (fail-closed)"
        record_violation "$refname" "$old" "$new" "linked-worktree" "$reason"
        exit 1
    fi
    if [ "$primary_status" -ne 0 ]; then
        exit 1
    fi

    if [ "$refname" = "refs/stash" ] && [ "$new" != "$zero" ]; then
        reason="refs/stash update in primary worktree old=$old new=$new"
        record_violation "$refname" "$old" "$new" "stash" "$reason"
        exit 1
    fi

    # Creating main has no previous history to destroy. Deletion and every
    # other ancestry-unknown result remain fail-closed.
    if [ "$old" = "$zero" ]; then
        continue
    fi

    # Git may report a protected ref in an otherwise meaningful transaction
    # without changing its object id (notably `git merge --abort`).  This is a
    # true no-op and cannot erase ledger history.
    if [ "$old" = "$new" ]; then
        continue
    fi

    if [ "$new" != "$zero" ]; then
        git merge-base --is-ancestor "$old" "$new" >/dev/null 2>&1
        ancestry_status=$?
        if [ "$ancestry_status" -eq 0 ]; then
            barrier_detail=$(pending_verdict_barrier "$old")
            barrier_status=$?
            if [ "$barrier_status" -eq 1 ]; then
                continue
            fi
            if [ "$barrier_status" -eq 0 ]; then
                barrier_task=$(printf '%s\n' "$barrier_detail" | cut -d '|' -f 1)
                barrier_attempt=$(printf '%s\n' "$barrier_detail" | cut -d '|' -f 2)
                barrier_event=$(printf '%s\n' "$barrier_detail" | cut -d '|' -f 3)
                barrier_head=$(printf '%s\n' "$barrier_detail" | cut -d '|' -f 4)
                barrier_started=$(printf '%s\n' "$barrier_detail" | cut -d '|' -f 5)
                if [ "$authorized_orch_merge" = "true" ] && [ "$barrier_started" = "true" ]; then
                    parents=$(git rev-list --parents -n 1 "$new" 2>/dev/null) || parents=""
                    set -- $parents
                    if [ "$#" -eq 3 ] && [ "$1" = "$new" ] && [ "$2" = "$old" ] && [ "$3" = "$barrier_head" ]; then
                        continue
                    fi
                fi
                reason="pending root PASS blocks refs/heads/main advance task=$barrier_task attempt=$barrier_attempt verdictEvent=$barrier_event"
            else
                reason="cannot determine pending root PASS barrier: $barrier_detail (fail-closed)"
            fi
            record_violation "$refname" "$old" "$new" "verdict-barrier" "$reason"
            exit 1
        fi
        if [ "$ancestry_status" -eq 1 ]; then
            reason="non-fast-forward refs/heads/main update old=$old new=$new"
        else
            reason="refs/heads/main ancestry check failed old=$old new=$new (fail-closed)"
        fi
    else
        reason="refs/heads/main deletion old=$old new=$new (fail-closed)"
    fi

    record_violation "$refname" "$old" "$new" "non-ff" "$reason"
    exit 1
done

exit 0
